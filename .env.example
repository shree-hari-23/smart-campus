# =============================================================================
# REVA SMART CAMPUS INTELLIGENCE & STUDENT SUCCESS PLATFORM (PACD-RAG)
# CONFIGURATION ENVIRONMENT TEMPLATE (.env.example)
# =============================================================================

# =============================================================================
# GOOGLE GEMINI AI CONFIGURATION
# =============================================================================
# 1. Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# 2. Paste your Gemini API key below:
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (default: gemini-2.5-flash)
# Supported options:
#   - gemini-2.5-flash (Fast, accurate, balanced)
#   - gemini-2.0-flash (Ultra fast)
#   - gemini-1.5-flash (Standard high quota)
#   - gemini-1.5-pro   (High reasoning capability)
GEMINI_MODEL=gemini-2.5-flash

# =============================================================================
# FLUXBASE DATABASE & COLLABORATIVE STORAGE CONFIGURATION
# =============================================================================
FLUXBASE_PROJECT_ID=your_fluxbase_project_id_here
FLUXBASE_API_KEY=your_fluxbase_api_key_here
FLUXBASE_BUCKET_ID=smart-campus

# =============================================================================
# REVA SMART CAMPUS PLATFORM - SMTP CREDENTIALS (NODEMAILER)
# =============================================================================
# To receive REAL OTP emails in your personal or university inbox:
# Fill in your outgoing SMTP credentials below.
#
# NOTE: If these variables are left empty, Nodemailer automatically falls back
# to Ethereal Email test SMTP transport with a web preview link on your screen.
# =============================================================================

# Option A: Brevo / Sendinblue / Gmail SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM="Student Success Platform <no-reply@reva.edu.in>"
SMTP_SECURE=false

# Optional: Override all OTP recipient emails to your personal test inbox
# SMTP_FORWARD_TO=your_personal_email@gmail.com
